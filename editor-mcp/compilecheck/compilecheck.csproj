<!--
  s&box Skill : headless compile check for SboxMcpServer.cs

  Author  : fobiat (Kyle Tarff) <kyle@fobiat.dev>
  Links   : https://fobiat.dev/   https://github.com/fobiat
  Licence : MIT, see LICENSE at the repository root.

  Run both nullable configurations through the driver, never this file alone:

    python editor-mcp/compilecheck/run.py

  Settings are copied from a real generated Editor/ project, engine 26.08.05,
  except that Nullable is a knob. The .sbproj "Nullables" field defaults to off,
  so the shipping configuration is the loose one, where an unguarded "string?" is
  CS8632 promoted to an error by TreatWarningsAsErrors. Building only with
  Nullable=enable, which this file used to do, tested the one configuration that
  cannot produce that failure.

  Known divergences, both because the generated project reaches into the Steam
  install: its six ProjectReferences to the shipped editor addons are omitted and
  the assemblies they carry are referenced directly instead, and the two Roslyn
  analyzers load only if present. Pass -p:CompileCheckAnalyzers=false to skip
  them.
-->
<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>sboxmcpserver-compilecheck</AssemblyName>
    <RootNamespace>Sandbox</RootNamespace>
    <LangVersion>14</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors></WarningsAsErrors>
    <DefineConstants>SANDBOX</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>1701;1702;1591</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <Nullable Condition="'$(Nullable)' == ''">enable</Nullable>
    <SboxManaged Condition="'$(SboxManaged)' == ''">$(SBOX_MANAGED)</SboxManaged>
  </PropertyGroup>

  <Target Name="RequireSboxManaged" BeforeTargets="BeforeBuild">
    <Error Condition="'$(SboxManaged)' == ''"
           Text="Set SboxManaged (or the SBOX_MANAGED environment variable) to your s&amp;box bin/managed/ directory. See the comment at the top of this file." />
    <Error Condition="!Exists('$(SboxManaged)Sandbox.Tools.dll')"
           Text="No Sandbox.Tools.dll under '$(SboxManaged)'. That is not an s&amp;box bin/managed/ directory." />
  </Target>

  <Target Name="ReportConfiguration" BeforeTargets="BeforeBuild">
    <Message Importance="high" Text="compilecheck: Nullable=$(Nullable), TreatWarningsAsErrors=$(TreatWarningsAsErrors)" />
  </Target>

  <ItemGroup>
    <Using Include="Sandbox.Internal.GlobalToolsNamespace" Static="true" />
    <Using Include="Sandbox.Internal.GlobalGameNamespace" Static="true" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../SboxMcpServer.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(CompileCheckAnalyzers)' != 'false'">
    <Analyzer Include="$(SboxManaged)Sandbox.CodeUpgrader.dll" Condition="Exists('$(SboxManaged)Sandbox.CodeUpgrader.dll')" />
    <Analyzer Include="$(SboxManaged)Sandbox.Generator.dll" Condition="Exists('$(SboxManaged)Sandbox.Generator.dll')" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Sandbox.System"><HintPath>$(SboxManaged)Sandbox.System.dll</HintPath></Reference>
    <Reference Include="Sandbox.Engine"><HintPath>$(SboxManaged)Sandbox.Engine.dll</HintPath></Reference>
    <Reference Include="Sandbox.Tools"><HintPath>$(SboxManaged)Sandbox.Tools.dll</HintPath></Reference>
    <Reference Include="Sandbox.Reflection"><HintPath>$(SboxManaged)Sandbox.Reflection.dll</HintPath></Reference>
    <Reference Include="Sandbox.Filesystem"><HintPath>$(SboxManaged)Sandbox.Filesystem.dll</HintPath></Reference>
    <Reference Include="Sandbox.Compiling"><HintPath>$(SboxManaged)Sandbox.Compiling.dll</HintPath></Reference>
    <Reference Include="Sandbox.AppSystem"><HintPath>$(SboxManaged)Sandbox.AppSystem.dll</HintPath></Reference>
    <Reference Include="Sandbox.Mounting"><HintPath>$(SboxManaged)Sandbox.Mounting.dll</HintPath></Reference>
    <Reference Include="Sandbox.Bind"><HintPath>$(SboxManaged)Sandbox.Bind.dll</HintPath></Reference>
    <Reference Include="Microsoft.CodeAnalysis"><HintPath>$(SboxManaged)Microsoft.CodeAnalysis.dll</HintPath></Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp"><HintPath>$(SboxManaged)Microsoft.CodeAnalysis.CSharp.dll</HintPath></Reference>
    <Reference Include="Microsoft.AspNetCore.Components"><HintPath>$(SboxManaged)Microsoft.AspNetCore.Components.dll</HintPath></Reference>
    <Reference Include="Facepunch.ActionGraphs"><HintPath>$(SboxManaged)Facepunch.ActionGraphs.dll</HintPath></Reference>
    <Reference Include="SkiaSharp"><HintPath>$(SboxManaged)SkiaSharp.dll</HintPath></Reference>
  </ItemGroup>

  <!-- Not in the generated project's direct list, kept because the six omitted
       ProjectReferences would have brought them in transitively. -->
  <ItemGroup>
    <Reference Include="Sandbox.Access"><HintPath>$(SboxManaged)Sandbox.Access.dll</HintPath></Reference>
    <Reference Include="Sandbox.Services"><HintPath>$(SboxManaged)Sandbox.Services.dll</HintPath></Reference>
    <Reference Include="Sandbox.Event"><HintPath>$(SboxManaged)Sandbox.Event.dll</HintPath></Reference>
    <Reference Include="Sandbox.NetCore"><HintPath>$(SboxManaged)Sandbox.NetCore.dll</HintPath></Reference>
  </ItemGroup>

</Project>
